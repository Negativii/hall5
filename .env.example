# Собственный пароль команды, минимум 12 символов. Без него вход закрыт.
ADMIN_PASSWORD=

# Порт и адрес сервера
PORT=3000
HOST=0.0.0.0

# When Nginx on the host proxies into Docker, list its bridge gateway IP.
# Keep the container port bound to 127.0.0.1; never use unrestricted proxy trust.
# TRUSTED_PROXY_IPS=172.17.0.1

# Публичный адрес сайта — нужен для корректных ссылок и QR
# PUBLIC_URL=https://hall.example.ru

# Максимальный размер одного файла, ГБ
MAX_UPLOAD_GB=8

# Ключ подписи cookies. Если не задан, создастся в data/secret.key
# SESSION_SECRET=

# Папка для данных (видео, постеры, база). По умолчанию ./data
# DATA_DIR=D:\hall5-data

# Необязательные явные пути к системным программам обработки видео
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Максимальное время кодирования одного видео, мс (по умолчанию 6 часов)
# MEDIA_TIMEOUT_MS=21600000

# Публичные реквизиты владельца сайта и оператора персональных данных.
# До заполнения всех трёх полей отправка комментариев и согласований отключена.
# Просмотр по паролю остаётся доступен. Эти сведения показываются в документах сайта.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_EMAIL=

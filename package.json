{
  "name": "kuog-hall",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.js --prod",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "setup:ffmpeg": "node node_modules/ffmpeg-static/install.js",
    "e2e": "node tests/e2e.mjs",
    "test": "node --test tests/reliability.mjs tests/scene.test.mjs",
    "test:backend": "node tests/backend-reliability.mjs",
    "test:player": "node tests/player-regression.mjs",
    "test:render": "node --experimental-strip-types --test tests/scene-renderer.mjs tests/demand-render.mjs tests/video-frames.mjs tests/playback-buffer.mjs",
    "test:media": "node --test tests/media-quality.mjs",
    "test:media-compatibility": "node --test tests/compatibility-preview.mjs",
    "test:player-compatibility": "node tests/media-compatibility-browser.mjs",
    "test:playback-efficiency": "node tests/playback-efficiency.mjs",
    "test:playback-errors": "node --experimental-strip-types --test tests/media-failure.mjs tests/playback-diagnostics.mjs && node tests/media-failure-browser.mjs",
    "test:playback-buffer": "node tests/playback-buffer-browser.mjs",
    "test:playback-startup": "node --experimental-strip-types --test tests/playback-sync.mjs && node tests/playback-startup-browser.mjs",
    "test:performance": "node tests/performance.mjs",
    "test:scene": "node tests/scene-browser.mjs",
    "launch": "node scripts/start.mjs",
    "test:media-mobile": "node --test tests/mobile-preview.mjs",
    "test:player-mobile": "node --experimental-strip-types --test tests/mobile-preview-policy.mjs && node tests/mobile-preview-browser.mjs",
    "test:video-scenes": "node tests/video-scenes-api.mjs",
    "test:video-scenes-admin": "node tests/video-scenes-admin-browser.mjs",
    "test:video-scenes-player": "node tests/video-scenes-player-browser.mjs",
    "test:private-access": "node tests/private-access.mjs",
    "test:legal": "node --test tests/legal.test.mjs",
    "test:project-workflow": "node tests/project-workflow-browser.mjs",
    "test:editor-workflow": "node tests/scene-workflow-browser.mjs",
    "test:replacement-cancel": "node tests/replacement-cancel.mjs",
    "test:smoke": "node tests/production-smoke.mjs",
    "test:audit": "node tests/audit.mjs"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.63.0",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
